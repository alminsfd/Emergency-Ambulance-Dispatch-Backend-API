model User {
     id         String   @id @default(uuid())
     name       String
     email      String   @unique
     password   String
     phone      String?
     role       UserRole @default(PATIENT)
     isVerified Boolean  @default(false)
     isDeleted  Boolean  @default(false)
     createdAt  DateTime @default(now())
     updatedAt  DateTime @updatedAt

     // Profile Relations
     driverProfile DriverProfile?

     // Activity & Transaction Relations
     patientRequests EmergencyRequest[] @relation("PatientRequests")
     handledRequests EmergencyRequest[] @relation("DispatcherRequests")
     payments        Payment[]
     auditLogs       AuditLog[]

     @@index([email])
     @@index([role])
}
