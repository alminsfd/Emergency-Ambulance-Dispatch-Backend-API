model User {
     id                 String       @id @default(uuid())
     name               String
     email              String       @unique
     phone              String?
     password           String?
     googleId           String?      @unique
     authProvider       AuthProvider @default(CREDENTIAL)
     role               UserRole     @default(PATIENT)
     status             UserStatus   @default(ACTIVE)
     needPasswordChange Boolean      @default(false)
     imageUrl           String       @default("")
     imagePublicId      String       @default("")
     isVerified         Boolean      @default(false)
     isDeleted          Boolean      @default(false)
     deletedAt          DateTime?
     createdAt          DateTime     @default(now())
     updatedAt          DateTime     @updatedAt

     // Profile Relations
     driverProfile DriverProfile?

     // Activity & Transaction Relations
     patientRequests EmergencyRequest[] @relation("PatientRequests")
     handledRequests EmergencyRequest[] @relation("DispatcherRequests")
     payments        Payment[]
     auditLogs       AuditLog[]

     @@index([email])
     @@index([role])
}
